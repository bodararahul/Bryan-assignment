# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use * to allow all origins (NOT recommended for production).
FRONTEND_URL="http://localhost:5173"

# ─── API & Session Authentication ─────────────────────────────────────────────
# Set a strong random string for server-to-server API Key (X-API-Key header)
API_KEY=your_secure_api_key_here

# JWT / HMAC session secret for web login tokens
JWT_SECRET=your_jwt_session_secret_here

# Admin login credentials for the Web UI (defaults to admin@leadmanager.com / Admin@123)
ADMIN_EMAIL=admin@leadmanager.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=LeadManager Admin

# ─── Supabase PostgreSQL Connection ───────────────────────────────────────────
# Replace all values below with your actual Supabase project credentials.
# Find these in: Supabase Dashboard → Project Settings → Database → Connection string
PG_HOST=your-project-pooler.supabase.com
PG_PORT=5432
PG_USER=postgres.your_project_ref
PG_PASSWORD=your_database_password
PG_DATABASE=postgres
