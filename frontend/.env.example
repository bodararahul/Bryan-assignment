# Backend API Base URL
# For local development via Vite proxy, leave empty or use http://localhost:3001/api
# For production backend deployed on Render:
VITE_API_URL=https://bryan-assignment-backend.onrender.com/api

# API Key (must match the API_KEY value set in backend .env)
# Leave empty if backend API_KEY is not configured (local dev only)
VITE_API_KEY=

# Single Demo User Credentials (optional defaults)
VITE_DEMO_EMAIL=admin@leadmanager.com
VITE_DEMO_PASSWORD=Admin@123
